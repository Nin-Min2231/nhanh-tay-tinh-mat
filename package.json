{
  "name": "nhanh-tay-tinh-mat",
  "version": "0.9.3",
  "private": true,
  "type": "module",
  "description": "Nhanh Tay Tinh Mắt – PWA 7 mini-game rèn tập trung cho bé lớp 2",
  "scripts": {
    "dev": "vite --host",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "samples": "cross-env GEN_SAMPLES=1 vitest run src/games/samples",
    "test:e2e": "playwright test",
    "lint": "eslint . && tsc --noEmit",
    "format": "prettier --write .",
    "build:pages": "cross-env BASE_PATH=/nhanh-tay-tinh-mat/ npm run build",
    "icons": "node scripts/make-icons.mjs",
    "perf": "node scripts/perf-fps.mjs"
  },
  "dependencies": {
    "@fontsource/nunito": "^5.3.0",
    "@preact/signals": "^2.11.3",
    "chart.js": "^4.5.1",
    "preact": "^11.0.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.0",
    "@preact/preset-vite": "^2.10.6",
    "@types/node": "^26.6.5",
    "cross-env": "^10.1.0",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.13.0",
    "prettier": "^3.9.10",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.1",
    "vite": "^8.3.4",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.0.3"
  }
}
